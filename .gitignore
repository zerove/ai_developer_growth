# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg
.venv/
venv/

# Testing
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*.*.*
htmlcov/
MagicMock/
# npm 依赖树（examples/ai-growth-vscode 实测约 27MB，由 npm install 重建）
node_modules/

# Coverage reports (generated by CI / local runs)
coverage.xml
combined-coverage.xml
coverage-artifacts/
.coverage-data
.coverage_data
coverage.json

# Local coverage variant files (avoid git noise)
.coverage-v*.json

# Tool cache
.tool_matrix_cache.json
tools/.cache/
*.backup

# Generated cache/data
.cache/
.ai-audit-history.json
.semantic_graph.json

# Quality-trends 运行时数据产物（保留目录占位 .gitkeep）
.quality-trends/*
!.quality-trends/.gitkeep

# tools/.quality-trends/ 运行时 ledger (本地预提交门禁产物)
tools/.quality-trends/*

# Mutation testing workspace (regenerated on demand)
mutants/
setup.cfg

# Tool reports (regenerated on demand)
diff-cover-report.html
bandit-report.json

# IDE
.vscode/
.idea/

# OS
.DS_Store
.Thumbs.db

# OpenCode session state & local cache
.opencode/

# OMO (project management)
.omo/

# mimocode 本地运行状态（cron 锁等，2026-10-10 实测曾污染工作区）
.mimocode/

# ai-context-sync 缓存目录（运行时生成，曾被测试写入工作区）
.ai-sync-cache/
.ai-sync-graph.db

# jcode (keep skills tracked)
.jcode/*
!.jcode/skills/
!.jcode/PROJECT.md
!.jcode/SWARM.md
!.jcode/hooks/
!.jcode/hooks.json
!.jcode/registry.json
!.jcode/scripts/
!.jcode/mode_decision.conf
# 质量门禁棘轮基线: 需随仓库分发，CI 才能豁免存量问题
!.jcode/baseline.json
!.jcode/USAGE.md
!.jcode/exceptions.yaml
!.jcode/ignored-rules.toml

# OpenCode (internal state)
.opencode/

# MkDocs build output
site/
# uv package manager lockfile
uv.lock
tools/scripts/rules_engine/*.bak

# SQLite 统一存储数据库（运行时生成）
*.db
*.db-wal
*.db-shm
debug_mutmut.py
.mutmut-cache

# 审计台账与运行时遥测（每轮操作自动追加，属本地运行状态而非源码）
.quality-trends/audit_ledger.jsonl
.quality-trends/evolution_log.json
.quality-trends/swarm_execution.json
.quality-trends/telemetry.json
logs/
adg-report.html

# 工具运行时生成产物（Machine-specific 基线 / 一次性报告，不入库）
.perf_baseline.json
case_quality_report.json

# ide_rules_sync.py 的产物。测试传的是 tmp_path（干净），但实测在跑全量
# 回归期间于仓库根生成了这两个文件 —— 写入路径未查明，疑似
# get_project_root() 在并发/stash 造成的目录结构瞬变下解析异常。
# 它们是模板产物而非配置，随 generate_ide_rules 重新生成即可。
.cursorrules
.windsurfrules

# helm dependency build 的下载产物 (Chart.lock 已锁定精确版本 + 远程仓库,
# `helm dep build` 可完整重建; 仓库内无任何代码/脚本/CI 引用这些文件)
helm/jcode-platform/charts/*.tgz
