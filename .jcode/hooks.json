{
  "version": "1.1",
  "hooks": {
    "on_commit": [
      {
        "name": "lint-check",
        "skill": "governance-auditor",
        "action": "lint",
        "description": "提交时自动检查代码风格",
        "command": "python .jcode/scripts/governance-auditor.py lint --lang python",
        "enabled": true
      },
      {
        "name": "governance-docs-check",
        "skill": "governance-docs-validator",
        "action": "validate",
        "description": "提交时验证治理文档格式",
        "condition": "files_contain('docs/efficiency/ai-')",
        "enabled": true
      },
      {
        "name": "ai-quality-gate",
        "skill": "governance-auditor",
        "action": "ai-quality-gate",
        "description": "提交时运行 AI 代码质量门禁",
        "enabled": true
      },
      {
        "name": "context-sync",
        "skill": "context-sync",
        "action": "sync",
        "description": "提交时同步上下文 (CONTEXT.md/ADR.md)",
        "enabled": true
      },
      {
        "name": "rules-yml-integrity-check",
        "skill": "governance-auditor",
        "action": "check-rules-yml-integrity",
        "description": "提交时验证 .adg/rules.yml 行数与 HEAD 一致 (Phase 29)",
        "command": "bash tools/scripts/check_rules_yml_integrity.sh",
        "condition": "files_contain('.adg/rules.yml')",
        "enabled": true
      },
      {
        "name": "hooks-json-integrity-check",
        "skill": "governance-auditor",
        "action": "check-hooks-json-integrity",
        "description": "提交时验证 .jcode/hooks.json 无 fail-open hook (Phase 30)",
        "command": "bash tools/scripts/check_hooks_json_integrity.sh",
        "condition": "files_contain('.jcode/hooks.json')",
        "enabled": true
      },
      {
        "name": "adr-index-check",
        "skill": "governance-auditor",
        "action": "check-adr-index",
        "description": "提交时验证 ADR 索引与 docs/adr/*.md 一致 (Phase 38)",
        "command": "python tools/scripts/generate_adr_index.py --check",
        "condition": "files_contain('docs/adr/')",
        "enabled": true
      }
    ],
    "on_pr": [
      {
        "name": "full-audit",
        "skill": "governance-auditor",
        "action": "full",
        "description": "PR 时运行完整审计",
        "command": "python .jcode/scripts/governance-auditor.py full --lang python",
        "enabled": true
      },
      {
        "name": "case-validation",
        "skill": "knowledge-curator",
        "action": "validate",
        "description": "PR 时验证案例格式",
        "command": "python tools/scripts/validate_case_study.py --all --strict",
        "condition": "files_contain('case-studies/')",
        "enabled": true
      },
      {
        "name": "link-audit",
        "skill": "knowledge-curator",
        "action": "audit",
        "description": "PR 时检查文档断链",
        "condition": "files_contain('docs/') || files_contain('*.md')",
        "enabled": true
      },
      {
        "name": "governance-index-check",
        "skill": "governance-docs-validator",
        "action": "check-index",
        "description": "PR 时验证治理层索引完整性",
        "condition": "files_contain('GOVERNANCE.md') || files_contain('INDEX.md') || files_contain('CLAUDE.md')",
        "enabled": true
      },
      {
        "name": "agent-definition-validation",
        "skill": "governance-auditor",
        "action": "validate-agent-definition",
        "description": "PR 时验证 Agent 定义格式",
        "command": "python tools/scripts/validate_agent_definition.py --path agents",
        "condition": "files_contain('agents/')",
        "enabled": true
      },
      {
        "name": "ai-annotation-check",
        "skill": "governance-auditor",
        "action": "check-ai-annotation",
        "description": "PR 时检查 AI 代码标注",
        "command": "python tools/scripts/check_ai_annotation.py --strict",
        "enabled": true
      },
      {
        "name": "context-audit",
        "skill": "context-sync",
        "action": "audit",
        "description": "PR 时审计规范合规性",
        "condition": "files_contain('tools/') || files_contain('examples/')",
        "enabled": true
      },
      {
        "name": "multi-agent-design",
        "skill": "multi-agent-orch",
        "action": "fanout",
        "description": "PR 时对设计类需求运行多 Agent 编排",
        "command": "python .jcode/scripts/multi-agent-orch.py fanout \"评审当前分支的设计变更\"",
        "condition": "files_contain('design/') || files_contain('spec/') || pr_label('design')",
        "enabled": true
      },
      {
        "name": "self-correction",
        "skill": "self-correction-loop",
        "action": "validate",
        "description": "PR 时验证测试状态，失败给修正建议",
        "command": "python .jcode/scripts/self-correction-loop.py validate --target . --tests tests --runner pytest --timeout 900",
        "enabled": true
      },
      {
        "name": "mutmut-changed",
        "skill": "governance-auditor",
        "action": "mutmut-changed",
        "description": "PR 时对受影响 Python 文件跑 mutmut 突变测试 (Phase 30 CI 化)",
        "command": "bash tools/scripts/mutmut_ci.sh --changed-only",
        "condition": "files_contain('tools/scripts/**/*.py') || files_contain('examples/**/*.py')",
        "enabled": true
      }
    ],
    "on_merge": [
      {
        "name": "sync-tools",
        "skill": "knowledge-curator",
        "action": "sync",
        "description": "合并后同步工具矩阵",
        "enabled": true
      },
      {
        "name": "context-sync-merge",
        "skill": "context-sync",
        "action": "sync",
        "description": "合并后同步上下文",
        "enabled": true
      },
      {
        "name": "rules-yml-integrity-check-merge",
        "skill": "governance-auditor",
        "action": "check-rules-yml-integrity",
        "description": "合并后验证 .adg/rules.yml 完整性 (Phase 30, 与 on_commit 双层防护)",
        "command": "bash tools/scripts/check_rules_yml_integrity.sh",
        "enabled": true
      }
    ],
    "scheduled": [
      {
        "name": "weekly-audit",
        "skill": "governance-auditor",
        "action": "full",
        "description": "每周完整审计",
        "schedule": "0 9 * * 1",
        "enabled": true
      },
      {
        "name": "weekly-scan",
        "skill": "knowledge-curator",
        "action": "scan",
        "description": "每周案例扫描",
        "schedule": "0 10 * * 1",
        "enabled": true
      },
      {
        "name": "efficiency-report",
        "skill": "workflow-optimizer",
        "action": "report",
        "description": "每月效率报告",
        "schedule": "0 9 1 * *",
        "enabled": true
      },
      {
        "name": "monthly-hallucination-audit",
        "skill": "governance-auditor",
        "action": "audit-hallucination-risks",
        "description": "每月幻觉风险审计",
        "schedule": "0 9 15 * *",
        "enabled": true
      },
      {
        "name": "monthly-quality-report",
        "skill": "governance-auditor",
        "action": "ai-quality-gate",
        "description": "每月 AI 代码质量报告",
        "schedule": "0 9 1 * *",
        "enabled": true
      },
      {
        "name": "weekly-context-sync",
        "skill": "context-sync",
        "action": "validate",
        "description": "每周验证上下文文档格式",
        "schedule": "0 11 * * 1",
        "enabled": true
      },
      {
        "name": "monthly-spec-audit",
        "skill": "context-sync",
        "action": "audit",
        "description": "每月规范审计",
        "schedule": "0 9 15 * *",
        "enabled": true
      }
    ]
  }
}
