# JCode Platform - Release Automation

# 版本管理
.PHONY: version bump-major bump-minor bump-patch version-verify

version: ## 显示当前版本
	python -m tools.scripts.release version

bump-major: ## 主版本号递增
	python -m tools.scripts.release bump major

bump-minor: ## 次版本号递增
	python -m tools.scripts.release bump minor

bump-patch: ## 补丁版本号递增 (默认)
	python -m tools.scripts.release bump patch

version-verify: ## 验证版本一致性
	python -m tools.scripts.release verify

# CHANGELOG
.PHONY: changelog
changelog: ## 生成/更新 CHANGELOG
	python -m tools.scripts.release changelog

# Docker 构建
.PHONY: docker-build docker-push docker-build-all

docker-build: ## 构建 Docker 镜像 (本地)
	python -m tools.scripts.docker_build --version $(VERSION) --no-push --platform linux/amd64

docker-push: ## 构建并推送 Docker 镜像
	python -m tools.scripts.docker_build --version $(VERSION) --push --platform linux/amd64,linux/arm64 --sbom --sign

docker-build-all: ## 构建所有组件镜像 (本地)
	python -m tools.scripts.docker_build --version $(VERSION) --no-push --platform linux/amd64,linux/arm64

# 完整发布流程
# 修复: 与 Makefile 的 release target 重复定义警告。
# 解决: 用 release-with-docker 替代, 不再重复定义 release。
# 用法: make -f Makefile.release release-with-docker
.PHONY: release-with-docker release-dry-run

release-with-docker: ## 完整发布流程 (版本递增 + CHANGELOG + Docker + 推送)
	@read -p "版本类型 (major/minor/patch) [patch]: " type; \
	type=$${type:-patch}; \
	make bump-$$type && \
	make docker-push VERSION=$$(python -m tools.scripts.release version) && \
	echo "✅ 发布完成: v$$(python -m tools.scripts.release version)"

release-dry-run: ## 试运行发布流程
	@read -p "版本类型 (major/minor/patch) [patch]: " type; \
	type=$${type:-patch}; \
	python -m tools.scripts.release bump $$type --dry-run && \
	python -m tools.scripts.docker_build --version $$(python -m tools.scripts.release version) --dry-run --platform linux/amd64,linux/arm64

# SBOM 生成
.PHONY: sbom
sbom: ## 生成所有镜像的 SBOM
	python -m tools.scripts.docker_build --version $(VERSION) --no-push --sbom

# 版本变量 (可被命令行覆盖)
VERSION ?= $(shell python -m tools.scripts.release version)

# 默认目标
# 修复: 与 Makefile 的 help target 重复定义警告。
# 解决: 用 release-help 替代, 不再重复定义 help。
# 用法: make -f Makefile.release release-help
.DEFAULT_GOAL := release-help

.PHONY: release-help
release-help:  ## 显示帮助
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-20s\033[0m %s\n", $$1, $$2}'
