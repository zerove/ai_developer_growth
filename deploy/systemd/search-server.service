[Unit]
Description=ADG knowledge search API server (ai_developer_growth)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/dev/ai_developer_growth
# 依赖安装: uv pip install -p .venv -r requirements.txt（fastapi/uvicorn/jieba）
# 预检：venv 解释器存在且 fastapi 可导入，失败信息直接进 journal
ExecStartPre=%h/dev/ai_developer_growth/.venv/bin/python -c "import fastapi, uvicorn, jieba; print('deps ok')"
ExecStart=%h/dev/ai_developer_growth/.venv/bin/python %h/dev/ai_developer_growth/scripts/search-server.py
Restart=on-failure
RestartSec=5
# 资源约束：检索服务轻量，超限即重启防泄漏拖垮整机
MemoryMax=512M
MemoryHigh=384M
CPUQuota=50%
Nice=5
# 安全加固：只读仓库、禁止提权
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=%h/dev/ai_developer_growth
PrivateTmp=true
# 端口 8001（仅绑 127.0.0.1），健康检查: curl --noproxy '*' http://127.0.0.1:8001/api/health

[Install]
WantedBy=default.target
