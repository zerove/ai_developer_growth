{
  "name": "vscode-adg",
  "displayName": "ADG Code Quality",
  "description": "AI Developer Governance — 实时代码质量扫描",
  "version": "0.1.0",
  "publisher": "adg",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Linters", "Programming Languages"],
  "keywords": ["adg", "governance", "code-quality", "security", "lint"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "adg.scanFile",
        "title": "ADG: Scan Current File"
      },
      {
        "command": "adg.scanWorkspace",
        "title": "ADG: Scan Workspace"
      }
    ],
    "configuration": {
      "title": "ADG",
      "properties": {
        "adg.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "在保存时自动扫描文件"
        },
        "adg.severityThreshold": {
          "type": "string",
          "enum": ["error", "warning", "info"],
          "default": "warning",
          "description": "问题严重性阈值"
        }
      }
    }
  }
}
