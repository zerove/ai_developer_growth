{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "group:allNonMajor",
    "schedule:weekly",
    "timezone:Asia/Shanghai"
  ],
  "labels": ["dependencies", "automated"],
  "commitMessagePrefix": "deps",
  "commitMessagePrefixDevelopment": "deps-dev",
  "commitMessageAction": "Update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "Renovated via Renovate Bot",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "versioning": "semver",
  "rangeStrategy": "replace",
  "prCreation": "not-pending",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "platformAutomergeOptions": {
    "mergeMethod": "squash"
  },
  "rebaseStalePrs": true,
  "rebaseWhen": "conflicted",
  "separateMajorMinor": false,
  "separateMultipleMajor": false,
  "ignoreUnstable": true,
  "minimumReleaseAge": "3 days",
  "pinDigests": true,
  "schedule": [
    "after 2am on monday",
    "before 6am on friday"
  ],
  "timezone": "Asia/Shanghai",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "major": {
    "enabled": false
  },
  "minor": {
    "enabled": true,
    "automerge": true
  },
  "patch": {
    "enabled": true,
    "automerge": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "vulnerability"]
  },
  "ignorePaths": [
    "**/node_modules/**",
    "**/vendor/**",
    "**/.venv/**",
    "**/.git/**",
    "**/__pycache__/**",
    "**/dist/**",
    "**/build/**",
    "*.lock"
  ],
  "packageRules": [
    {
      "description": "Group Python dev tools",
      "matchPackageNames": ["pytest*", "ruff*", "mypy*", "black*", "isort*", "pre-commit*"],
      "groupName": "python-dev-tools",
      "labels": ["python", "dev-tools"]
    },
    {
      "description": "Group Python web frameworks",
      "matchPackageNames": ["fastapi*", "uvicorn*", "starlette*", "httpx*"],
      "groupName": "python-web",
      "labels": ["python", "web"]
    },
    {
      "description": "Group Python data science",
      "matchPackageNames": ["numpy*", "pandas*", "pydantic*"],
      "groupName": "python-data",
      "labels": ["python", "data"]
    },
    {
      "description": "Group Python security packages",
      "matchPackageNames": ["cryptography*", "pyjwt*", "bcrypt*", "passlib*"],
      "groupName": "python-security",
      "labels": ["python", "security"]
    },
    {
      "description": "Group Node.js dev tools",
      "matchPackageNames": ["eslint*", "prettier*", "typescript*", "@types/*", "jest*"],
      "groupName": "node-dev-tools",
      "labels": ["node", "dev-tools"]
    },
    {
      "description": "Group Docker base images",
      "matchPackageNames": ["python:*", "node:*", "alpine:*", "ubuntu:*", "debian:*"],
      "groupName": "docker-base-images",
      "labels": ["docker", "base-image"]
    },
    {
      "description": "Pin git dependencies",
      "matchDatasources": ["git"],
      "pinDigests": true
    },
    {
      "description": "Pin Docker digests",
      "matchDatasources": ["docker"],
      "pinDigests": true
    }
  ]
}
