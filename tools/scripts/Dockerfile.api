# JCode Platform - API Server Dockerfile
# 多阶段构建: 构建 -> 运行

# ──────────────────────────────────────────────────────────
# 构建阶段
# ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

# 安装构建依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /app

# 复制依赖文件
COPY pyproject.toml README.md ./
COPY tools/scripts/ ./tools/scripts/

# 安装依赖 (使用缓存)
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -e .

# ──────────────────────────────────────────────────────────
# 运行阶段
# ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

# 创建非 root 用户
RUN groupadd -r jcode && useradd -r -g jcode -d /app -s /sbin/nologin jcode

# 安装运行时依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /app

# 从构建阶段复制安装好的包
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# 复制应用代码
COPY --chown=jcode:jcode tools/scripts/ ./tools/scripts/
COPY --chown=jcode:jcode pyproject.toml README.md ./

# 切换到非 root 用户
USER jcode

# 环境变量
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import sys; sys.path.insert(0, '/app'); from tools.scripts.jcode_ai_native_workflow import JCodeAINativeWorkflow; print('OK')" || exit 1

# 暴露端口
EXPOSE 8080

# 启动命令
CMD ["python", "-m", "tools.scripts.jcode_ai_native_workflow", "--help"]
