{
  "theme": "One Dark",
  "ui_font_size": 16,
  "buffer_font_size": 14,
  "buffer_font_family": "JetBrains Mono",
  "autosave": "on_focus_change",
  "vim_mode": true,
  "soft_wrap": "editor_width",
  "tab_size": 2,
  "format_on_save": "on",
  "assistant": {
    "version": "1",
    "enabled": true,
    "default_model": "gpt-4o"
  },
  "terminal": {
    "font_family": "JetBrains Mono",
    "font_size": 14
  },
  "gutter": {
    "line_numbers": true
  }
}
